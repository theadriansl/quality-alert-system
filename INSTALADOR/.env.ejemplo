# ============================================
# IxT-QMS - Configuracion del Backend
# ============================================
# Copiar este archivo a: backend/.env
# y modificar los valores segun tu entorno
# ============================================

# Puerto del servidor backend
PORT=3001

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apqp_system
DB_USER=postgres
DB_PASSWORD=TU_CONTRASENA_AQUI

# Clave secreta para tokens JWT (cambiar en produccion!)
JWT_SECRET=cambiar_esta_clave_secreta_en_produccion_usar_algo_largo_y_aleatorio

# Tiempo de expiracion del token (en horas)
JWT_EXPIRES_IN=24

# Entorno (development, production)
NODE_ENV=production

# Configuracion de email (opcional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_email@gmail.com
# SMTP_PASS=tu_contrasena_app

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:3000
